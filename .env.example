# ---------------------------------------------------------------------------
# Login
# ---------------------------------------------------------------------------
# The passcode typed on the login screen. If unset, the app falls back to
# "elite" and warns you on the login page. Set this before deploying.
BCC_PASSCODE=change-me

# Signs the session cookie. Any long random string: openssl rand -hex 32
BCC_SESSION_SECRET=change-me-too

# ---------------------------------------------------------------------------
# Storage — optional locally, REQUIRED for any hosted deployment
# ---------------------------------------------------------------------------
# With these set, the whole database is stored in a hosted key-value store and
# survives redeploys. Without them the app writes data/db.json, which is fine on
# your own machine and gets wiped on every deploy on a serverless host.
#
# Vercel's KV/Redis integration injects these two automatically when you connect
# a store to the project — you should not need to paste them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# The Upstash marketplace naming is read too, if that is what you have:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
